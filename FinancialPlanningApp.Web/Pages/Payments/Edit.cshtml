@page "{id:long}"
@model FinancialPlanningApp.Web.Pages.Payments.EditModel
@{
    ViewData["Title"] = "Betalingstemplate bewerken";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h2 class="mb-1">Betalingstemplate bewerken</h2>
        <p class="text-muted mb-0">Werk planning, bedrag en herkenning voor deze recurrente betaling bij.</p>
    </div>
    <a href="@Model.GetBackUrl()" class="btn btn-outline-secondary">Terug</a>
</div>

<form method="post" class="mt-3" data-payment-form>
    <input asp-for="ReturnUrl" type="hidden" />
    <input asp-for="NavKey" type="hidden" />
    <input asp-for="NavIndex" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_PaymentFormFields" for="Input" />

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-4">
        <div class="d-flex gap-2 flex-wrap">
            <button type="submit" asp-page-handler="SaveReturn" class="btn btn-primary">Opslaan en terug</button>
            <button type="submit" asp-page-handler="SaveStay" class="btn btn-outline-primary">Opslaan</button>
            <button type="submit" asp-page-handler="SaveNext" class="btn btn-outline-primary" disabled="@(!Model.HasNext)">Opslaan en volgende</button>
            <a href="@Model.GetBackUrl()" class="btn btn-outline-secondary" data-dirty-link>Annuleren</a>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="@(Model.PreviousUrl ?? "#")" class="btn btn-outline-secondary @(Model.HasPrevious ? "" : "disabled")" data-dirty-link>Vorige</a>
            <a href="@(Model.NextUrl ?? "#")" class="btn btn-outline-secondary @(Model.HasNext ? "" : "disabled")" data-dirty-link>Volgende</a>
        </div>
    </div>
</form>

<div class="modal fade" id="unsavedChangesModal" tabindex="-1" aria-labelledby="unsavedChangesTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="unsavedChangesTitle">Niet-opgeslagen wijzigingen</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Sluiten"></button>
            </div>
            <div class="modal-body">
                Er zijn wijzigingen die nog niet opgeslagen zijn. Wil je doorgaan zonder op te slaan?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuleren</button>
                <a href="#" class="btn btn-danger" data-leave-without-saving>Doorgaan zonder opslaan</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_PaymentFormScripts" />
    <script>
        (() => {
            const form = document.querySelector('[data-payment-form]');
            const modalElement = document.getElementById('unsavedChangesModal');
            const leaveLink = document.querySelector('[data-leave-without-saving]');
            if (!form || !modalElement || !leaveLink || !window.bootstrap) return;

            const initial = new FormData(form);
            const initialValue = Array.from(initial.entries()).map(([key, value]) => `${key}=${value}`).join('&');
            const modal = new bootstrap.Modal(modalElement);

            const isDirty = () => {
                const current = new FormData(form);
                return Array.from(current.entries()).map(([key, value]) => `${key}=${value}`).join('&') !== initialValue;
            };

            document.querySelectorAll('[data-dirty-link]').forEach(link => {
                link.addEventListener('click', event => {
                    if (link.classList.contains('disabled') || !isDirty()) return;
                    event.preventDefault();
                    leaveLink.href = link.href;
                    modal.show();
                });
            });
        })();
    </script>
}
