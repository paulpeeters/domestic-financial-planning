@page
@model FinancialPlanningApp.Web.Pages.Reports.PaymentsByItemModel
@{
    ViewData["Title"] = "Betalingen per post over jaren";
    var monthNames = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.MonthNames.Take(12).ToArray();
}

<h2>Betalingen per post over jaren</h2>

<p class="text-muted">
    Vergelijk de werkelijk betaalde bedragen per maand over meerdere jaren. Selecteer meerdere posten om bijvoorbeeld
    een providerwissel binnen hetzelfde rapportjaar samen op te volgen.
</p>

<form method="get" class="mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-sm-auto">
            <label asp-for="FromYear" class="form-label">Beginjaar</label>
            <input asp-for="FromYear" class="form-control" type="number" min="2000" max="2100" style="max-width: 140px;" />
        </div>
        <div class="col-sm-auto">
            <label asp-for="ToYear" class="form-label">Eindjaar</label>
            <input asp-for="ToYear" class="form-control" type="number" min="2000" max="2100" style="max-width: 140px;" />
        </div>
        <div class="col-sm-auto">
            <label asp-for="StartMonth" class="form-label">Startmaand rapportjaar</label>
            <select asp-for="StartMonth" class="form-select" style="max-width: 200px;">
                @for (var month = 1; month <= 12; month++)
                {
                    <option value="@month">@monthNames[month - 1]</option>
                }
            </select>
        </div>
    </div>

    <fieldset class="mt-3">
        <legend class="form-label mb-2">Posten</legend>
        <div class="border rounded p-2 overflow-auto" style="max-height: 15rem;">
            @if (Model.TemplateOptions.Count == 0)
            {
                <span class="text-muted">Er zijn nog geen recurrente posten.</span>
            }
            @foreach (var option in Model.TemplateOptions)
            {
                <div class="form-check">
                    <input class="form-check-input"
                           type="checkbox"
                           name="TemplateIds"
                           value="@option.Id"
                           id="template-@option.Id"
                           checked="@(Model.TemplateIds.Contains(option.Id))" />
                    <label class="form-check-label" for="template-@option.Id">
                        @option.Description
                        <span class="text-muted small">(@option.Validity@(option.IsActive ? "" : ", niet actief"))</span>
                    </label>
                </div>
            }
        </div>
    </fieldset>

    <button type="submit" class="btn btn-outline-secondary mt-3">Rapport laden</button>
</form>

@if (Model.ValidationMessage is not null)
{
    <div class="alert alert-warning" role="alert">@Model.ValidationMessage</div>
}
else if (Model.TemplateIds.Count == 0)
{
    <div class="alert alert-info" role="status">Selecteer minstens één post om het rapport te tonen.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-sm align-middle">
            <thead>
                <tr>
                    <th scope="col">Maand</th>
                    @foreach (var year in Model.Years)
                    {
                        <th scope="col" class="text-end">@year.Label</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var month in Model.Months)
                {
                    <tr>
                        <th scope="row">@month.Label</th>
                        @foreach (var cell in month.Cells)
                        {
                            <td class="text-end">
                                <span>@cell.Total.ToString("F2")</span>
                                @if (Model.TemplateIds.Count > 1 && cell.Items.Count > 0)
                                {
                                    <div class="small text-muted">
                                        @foreach (var item in cell.Items)
                                        {
                                            <div title="@item.Description">@item.Description: @item.Amount.ToString("F2")</div>
                                        }
                                    </div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-secondary fw-semibold">
                    <th scope="row">Jaartotaal</th>
                    @foreach (var total in Model.YearTotals)
                    {
                        <td class="text-end">@total.ToString("F2")</td>
                    }
                </tr>
            </tfoot>
        </table>
    </div>
}
