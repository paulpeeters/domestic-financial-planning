@page
@model FinancialPlanningApp.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Aanmelden";
}

<h2>Aanmelden</h2>
@if (Model.IsDesktopMode)
{
    <p class="text-muted">Meld aan bij je lokale financiële planning op deze computer.</p>
}

<form method="post" class="mt-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label"></label>
        <input asp-for="Input.Email" class="form-control" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label"></label>
        <input asp-for="Input.Password" class="form-control" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button type="submit" class="btn btn-primary">Aanmelden</button>
        <a asp-page="/Account/ForgotPassword" class="btn btn-link">Wachtwoord vergeten?</a>
    </div>
</form>
