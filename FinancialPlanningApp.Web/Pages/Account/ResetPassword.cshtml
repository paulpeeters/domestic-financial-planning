@page
@model FinancialPlanningApp.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Wachtwoord resetten";
}

<h2>Wachtwoord resetten</h2>

@if (Model.Completed)
{
    <div class="alert alert-success" role="alert">
        Je wachtwoord is gewijzigd.
    </div>
    <a asp-page="/Account/Login" class="btn btn-primary">Aanmelden</a>
}
else
{
    <form method="post" class="mt-3" style="max-width: 520px;">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input asp-for="Input.Token" type="hidden" />
        <div class="mb-3">
            <label asp-for="Input.NewPassword" class="form-label">Nieuw wachtwoord</label>
            <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.ConfirmPassword" class="form-label">Nieuw wachtwoord bevestigen</label>
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Nieuw wachtwoord opslaan</button>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
