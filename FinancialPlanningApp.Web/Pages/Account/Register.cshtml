@page
@model FinancialPlanningApp.Web.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Registreren";
}

<h2>Account aanmaken</h2>
@if (!Model.IsSelfRegistrationEnabled)
{
    <div class="alert alert-warning mt-3">
        Zelfregistratie is momenteel uitgeschakeld.
    </div>
}
else
{
<form method="post" class="mt-3">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Input.Email" class="form-label"></label>
        <input asp-for="Input.Email" class="form-control" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.FirstName" class="form-label">Voornaam</label>
        <input asp-for="Input.FirstName" class="form-control" />
        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.LastName" class="form-label">Naam</label>
        <input asp-for="Input.LastName" class="form-control" />
        <span asp-validation-for="Input.LastName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.AvatarUrl" class="form-label">Avatar-afbeelding URL</label>
        <input asp-for="Input.AvatarUrl" class="form-control" />
        <span asp-validation-for="Input.AvatarUrl" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label"></label>
        <input asp-for="Input.Password" class="form-control" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Registreren</button>
</form>
}
