@page
@model FinancialPlanningApp.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Wachtwoord vergeten";
}

<h2>Wachtwoord vergeten</h2>

@if (Model.IsDesktopMode)
{
    @if (Model.DesktopCompleted)
    {
        <div class="alert alert-success" role="status">
            Het wachtwoord is aangepast. Je kunt nu aanmelden met je nieuwe wachtwoord.
        </div>
        <a asp-page="/Account/Login" class="btn btn-primary">Naar aanmelden</a>
    }
    else if (!Model.DesktopRecoverySettings.IsConfigured)
    {
        <div class="alert alert-warning" role="alert">
            Lokaal wachtwoordherstel is nog niet ingesteld voor deze installatie. Stel dit in via <strong>Instellingen en backup</strong> zodra je opnieuw toegang hebt.
        </div>
        <a asp-page="/Account/Login" class="btn btn-outline-secondary">Terug naar aanmelden</a>
    }
    else
    {
        <p class="text-muted">Gebruik het herstelantwoord of de herstelcode van deze lokale installatie om een nieuw wachtwoord in te stellen.</p>

        @if (Model.LocalUserEmails.Count > 0)
        {
            <div class="alert alert-light border" role="status">
                <div class="fw-semibold mb-1">Lokale aanmeldingen op deze computer</div>
                <ul class="mb-0">
                    @foreach (var email in Model.LocalUserEmails)
                    {
                        <li><code>@email</code></li>
                    }
                </ul>
            </div>
        }

        <form method="post" class="mt-3" style="max-width: 640px;">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="DesktopInput.Email" class="form-label"></label>
                <input asp-for="DesktopInput.Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="DesktopInput.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Herstelvraag</label>
                <div class="form-control-plaintext">@Model.DesktopRecoverySettings.Question</div>
            </div>
            <div class="mb-3">
                <label asp-for="DesktopInput.RecoveryAnswerOrCode" class="form-label"></label>
                <input asp-for="DesktopInput.RecoveryAnswerOrCode" class="form-control" autocomplete="off" />
                <span asp-validation-for="DesktopInput.RecoveryAnswerOrCode" class="text-danger"></span>
                <div class="form-text">Je mag hier het antwoord op de herstelvraag of de herstelcode invullen.</div>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="DesktopInput.NewPassword" class="form-label"></label>
                    <input asp-for="DesktopInput.NewPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="DesktopInput.NewPassword" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="DesktopInput.ConfirmPassword" class="form-label"></label>
                    <input asp-for="DesktopInput.ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="DesktopInput.ConfirmPassword" class="text-danger"></span>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Wachtwoord wijzigen</button>
                <a asp-page="/Account/Login" class="btn btn-link">Terug naar aanmelden</a>
            </div>
        </form>
    }
}
else if (Model.Submitted)
{
    <div class="alert alert-info" role="alert">
        Als er een actieve account bestaat voor dat e-mailadres, is er een resetlink verstuurd.
    </div>
}
else
{
    <form method="post" class="mt-3" style="max-width: 520px;">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label">Email</label>
            <input asp-for="Input.Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Resetlink versturen</button>
        <a asp-page="/Account/Login" class="btn btn-link">Terug naar aanmelden</a>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
