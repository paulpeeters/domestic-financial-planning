@page
@model FinancialPlanningApp.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Wachtwoord vergeten";
}

<h2>Wachtwoord vergeten</h2>

@if (Model.Submitted)
{
    <div class="alert alert-info" role="alert">
        Als er een actieve account bestaat voor dat e-mailadres, is er een resetlink verstuurd.
    </div>
}
else
{
    <form method="post" class="mt-3" style="max-width: 520px;">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label">Email</label>
            <input asp-for="Input.Email" class="form-control" autocomplete="email" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Resetlink versturen</button>
        <a asp-page="/Account/Login" class="btn btn-link">Terug naar aanmelden</a>
    </form>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
