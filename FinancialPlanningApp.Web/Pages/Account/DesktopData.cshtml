@page
@model FinancialPlanningApp.Web.Pages.Account.DesktopDataModel
@{
    ViewData["Title"] = "Instellingen en backup";
}

<div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-start gap-2 mb-3">
    <div>
        <h1>Instellingen en backup</h1>
        <p class="text-muted mb-0">Beheer lokale provisie-instellingen, bekijk waar de database staat en maak een backupbestand.</p>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-success" role="status">@Model.StatusMessage</div>
}

@if (!string.IsNullOrWhiteSpace(Model.NewRecoveryCode))
{
    <div class="alert alert-warning" role="status">
        <h2 class="h5">Nieuwe herstelcode</h2>
        <p>Bewaar deze code op papier of in je wachtwoordmanager. De code wordt niet opnieuw getoond.</p>
        <p class="fs-5 mb-0"><code>@Model.NewRecoveryCode</code></p>
    </div>
}

<section class="border rounded p-3 mb-3">
    <h2 class="h5">Maandelijkse provisie</h2>
    <form method="post" asp-page-handler="ProvisionSettings" class="row g-3 align-items-start">
        <div class="col-sm-4 col-lg-3">
            <label asp-for="ProvisionSettings.MonthlyProvisionDay" class="form-label mb-1">Stortingsdag</label>
            <input asp-for="ProvisionSettings.MonthlyProvisionDay" class="form-control" type="number" min="1" max="28" />
            <span asp-validation-for="ProvisionSettings.MonthlyProvisionDay" class="text-danger"></span>
        </div>
        <div class="col-sm-5 col-lg-4">
            <label asp-for="ProvisionSettings.MonthlyProvisionAmount" class="form-label mb-1">Vast bedrag</label>
            <input asp-for="ProvisionSettings.MonthlyProvisionAmount" class="form-control" type="text" inputmode="decimal" data-val="false" placeholder="automatisch berekend" />
            <div class="form-text">Laat leeg om jaarplanning / 12 te gebruiken.</div>
            <span asp-validation-for="ProvisionSettings.MonthlyProvisionAmount" class="text-danger"></span>
        </div>
        <div class="col-sm-auto d-flex align-items-start pt-sm-4">
            <button type="submit" class="btn btn-primary">Provisie opslaan</button>
        </div>
    </form>
</section>

<section class="border rounded p-3 mb-3">
    <h2 class="h5">Wachtwoordherstel</h2>
    <p class="text-muted">
        @(Model.RecoverySettings.IsConfigured
            ? "Wachtwoordherstel is ingesteld. Als je dit wijzigt, wordt een nieuwe herstelcode gemaakt."
            : "Stel een herstelvraag in en bewaar de herstelcode. Zo kun je je wachtwoord herstellen zonder e-mail.")
    </p>
    <form method="post" asp-page-handler="RecoverySettings" class="row g-3 align-items-start">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="col-lg-6">
            <label asp-for="RecoverySettingsInput.Question" class="form-label mb-1">Herstelvraag</label>
            <input asp-for="RecoverySettingsInput.Question" class="form-control" />
            <span asp-validation-for="RecoverySettingsInput.Question" class="text-danger"></span>
        </div>
        <div class="col-lg-4">
            <label asp-for="RecoverySettingsInput.Answer" class="form-label mb-1">Nieuw herstelantwoord</label>
            <input asp-for="RecoverySettingsInput.Answer" class="form-control" autocomplete="off" />
            <div class="form-text">Het antwoord wordt versleuteld opgeslagen.</div>
            <span asp-validation-for="RecoverySettingsInput.Answer" class="text-danger"></span>
        </div>
        <div class="col-lg-auto d-flex align-items-start pt-lg-4">
            <button type="submit" class="btn btn-primary">Herstel opslaan</button>
        </div>
    </form>
</section>

<section class="border rounded p-3 mb-3">
    <h2 class="h5">Lokale database</h2>
    <dl class="row mb-0">
        <dt class="col-md-3">Databasebestand</dt>
        <dd class="col-md-9"><code class="text-break">@Model.DataInfo.DatabasePath</code></dd>
        <dt class="col-md-3">Map</dt>
        <dd class="col-md-9"><code class="text-break">@Model.DataInfo.DatabaseDirectory</code></dd>
        <dt class="col-md-3">Status</dt>
        <dd class="col-md-9">@(Model.DataInfo.DatabaseExists ? "Aanwezig" : "Nog niet aangemaakt")</dd>
        <dt class="col-md-3">Backupmap</dt>
        <dd class="col-md-9"><code class="text-break">@Model.DataInfo.BackupDirectory</code></dd>
    </dl>
</section>

<form method="post" asp-page-handler="Backup">
    <button type="submit" class="btn btn-primary" disabled="@(!Model.DataInfo.DatabaseExists)">Backup downloaden</button>
    <a asp-page="/Index" class="btn btn-outline-secondary">Terug</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
