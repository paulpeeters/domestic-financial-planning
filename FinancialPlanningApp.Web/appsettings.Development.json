{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  },
  "Database": {
    "Provider": "MySql",
    "ConnectionString": "Server=@{DB_HOST};Port=@{DB_PORT};Database=@{DB_NAME};User ID=@{DB_USER};Password=@{DB_PASSWORD};Allow User Variables=true;"
  },
  "Application": {
    "Mode": "MultiTenant"
  }
}
