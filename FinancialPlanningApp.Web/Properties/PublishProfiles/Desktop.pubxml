<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <FinancialPlanningDeployRoot Condition="'$(FinancialPlanningDeployRoot)' == ''">$(MSBuildProjectDirectory)\..\..\DEPLOY\FinancialPlanning</FinancialPlanningDeployRoot>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LaunchSiteAfterPublish>false</LaunchSiteAfterPublish>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <PublishProvider>FileSystem</PublishProvider>
    <PublishUrl>$(FinancialPlanningDeployRoot)\Desktop\</PublishUrl>
    <PublishDir>$(FinancialPlanningDeployRoot)\Desktop\</PublishDir>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <UseAppHost>true</UseAppHost>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnvironmentName>Desktop</EnvironmentName>
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <Target Name="CreateDesktopModeMarker" AfterTargets="Publish">
    <WriteLinesToFile File="$(PublishDir)desktop.mode" Lines="SingleUserDesktop" Overwrite="true" />
  </Target>
</Project>
