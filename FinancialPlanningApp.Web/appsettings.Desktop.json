{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=%LOCALAPPDATA%\\DomesticFinancialPlanning\\app.db"
  },
  "Application": {
    "Mode": "SingleUserDesktop",
    "PreferredDesktopPort": 5196,
    "OpenBrowserOnStart": true
  },
  "Updates": {
    "Enabled": true,
    "LatestReleaseUrl": "https://financialplanning.pware.be/updates/latest.json",
    "ReleasePageUrl": "https://financialplanning.pware.be/",
    "CacheMinutes": 360,
    "TimeoutSeconds": 2
  }
}
